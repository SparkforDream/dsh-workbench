{
  "name": "dsh-workbench",
  "version": "0.3.0",
  "description": "会话看板：AI 实际工作时长（剔除等待审批与回答）、按工具聚合耗时、资源管理器快捷入口、会话内查找，以及需要确认时的重复提醒音。",
  "type": "module",
  "license": "MIT",
  "author": "goldenglow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkforDream/dsh-workbench.git"
  },
  "homepage": "https://github.com/SparkforDream/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/SparkforDream/dsh-workbench/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "timing",
    "stats"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/build-preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "preview/*.png"
  ]
}

