{
  "name": "dsh-powertoys",
  "version": "0.4.0",
  "description": "DSH PowerToys：模块化工作台工具集，支持在设置页独立开关 AI 实际工作时长、工作区目录入口、会话内查找、页面刷新与需要确认时的重复提醒音，即时生效。",
  "type": "module",
  "license": "MIT",
  "author": "goldenglow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkforDream/dsh-powertoys.git"
  },
  "homepage": "https://github.com/SparkforDream/dsh-powertoys#readme",
  "bugs": {
    "url": "https://github.com/SparkforDream/dsh-powertoys/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "powertoys",
    "timing",
    "stats"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/build-preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "preview/*.png"
  ]
}

